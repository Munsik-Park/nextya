# ── Server ──────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── GitHub ──────────────────────────────────────
# Personal Access Token (repo 읽기 권한 필요)
GITHUB_TOKEN=ghp_your_token_here

# Webhook 서명 검증 시크릿 (GitHub Webhook 설정의 Secret 값)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# 기본 분석 대상 레포 (owner/repo 형식, 선택사항)
DEFAULT_REPO=

# ── LLM ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here

# 분석에 사용할 모델 (기본: claude-haiku-4-5-20251001)
ANALYSIS_MODEL=claude-haiku-4-5-20251001

# ── Database ─────────────────────────────────────
DATABASE_PATH=./data/nextya.db

# ── Analysis ─────────────────────────────────────
# 의존성 신뢰도 임계값 (이 값 미만은 저장하지 않음, 0.0~1.0)
CONFIDENCE_THRESHOLD=0.6

# 분석 시 불러올 최대 이슈 수
MAX_ISSUES_PER_ANALYSIS=100
